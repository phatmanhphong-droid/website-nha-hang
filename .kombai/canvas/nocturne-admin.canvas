      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n.font-display{font-family:'Playfair Display',Georgia,serif}\n.font-body{font-family:'Be Vietnam Pro','Helvetica Neue',sans-serif}\n.tnum{font-variant-numeric:tabular-nums}\n.thin-scroll{scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.15) transparent}\n</style>\n<div class=\"font-body flex h-[900px] w-full flex-col overflow-hidden bg-[#131010] text-white\" data-kid=\"1\" data-name=\"admin app layout container\">\n<header class=\"flex h-[64px] shrink-0 items-center justify-between border-b border-white/10 bg-[#1D1312] px-5\" data-kid=\"1-1\" data-name=\"top app header bar\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-1-1\" data-name=\"header brand and view toggle group\">\n<span class=\"font-display text-[22px] leading-none tracking-[0.22em] text-[#F8D127]\" data-kid=\"1-1-1-1\" data-name=\"brand wordmark NOCTURNE\">NOCTURNE</span>\n<div class=\"flex border border-white/15 text-[13px]\" data-kid=\"1-1-1-2\" data-name=\"header view mode toggle group\">\n<button class=\"h-9 bg-white/10 px-4 text-white\" data-kid=\"1-1-1-2-1\" data-name=\"operations view toggle button (active)\">Vận hành</button>\n<button class=\"h-9 px-4 text-white/55 hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"management view toggle button\">Quản trị</button>\n</div>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-1-2\" data-name=\"header user identity cluster\">\n<div class=\"grid size-9 place-items-center rounded-full bg-[#941E21] text-[13px] font-semibold\" data-kid=\"1-1-2-1\" data-name=\"user avatar initials badge\">KN</div>\n<div class=\"leading-tight\" data-kid=\"1-1-2-2\" data-name=\"user name and role block\"><div class=\"text-[14px]\" data-kid=\"1-1-2-2-1\" data-name=\"signed-in use