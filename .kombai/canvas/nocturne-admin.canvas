ols-[52px_1fr_32px_130px] items-center gap-2\" data-kid=\"1-2-2-2-2-1-4-5-2\" data-name=\"other booking row: Phan Thị Mai (deposit received)\"><span class=\"text-white/60\" data-kid=\"1-2-2-2-2-1-4-5-2-1\" data-name=\"other booking time\">19:30</span><span data-kid=\"1-2-2-2-2-1-4-5-2-2\" data-name=\"other booking guest and space\">Phan Thị Mai <span class=\"text-[12px] text-white/45\" data-kid=\"1-2-2-2-2-1-4-5-2-2-1\" data-name=\"other booking space name\">Bàn cửa sổ</span></span><span class=\"text-right\" data-kid=\"1-2-2-2-2-1-4-5-2-3\" data-name=\"other booking party size\">2</span><span class=\"flex items-center justify-end gap-2 text-[13px] text-white/75\" data-kid=\"1-2-2-2-2-1-4-5-2-4\" data-name=\"other booking status: deposit received\"><span class=\"size-2 rounded-full bg-[#9CC79A]\" data-kid=\"1-2-2-2-2-1-4-5-2-4-1\" data-name=\"status dot: deposit received (green)\"></span>Đã nhận cọc</span></li>\n</ul>\n</div>\n<!-- Deposit -->\n<div class=\"flex items-center justify-between px-5 py-4 text-[14px]\" data-kid=\"1-2-2-2-2-1-5\" data-name=\"deposit summary row\">\n<div class=\"flex items-center gap-2 text-white/60\" data-kid=\"1-2-2-2-2-1-5-1\" data-name=\"deposit label and breakdown\"><i class=\"ph ph-receipt text-[17px]\" data-kid=\"1-2-2-2-2-1-5-1-1\" data-name=\"deposit icon and label\"></i>Cọc dự kiến <span class=\"tnum text-white/45\" data-kid=\"1-2-2-2-2-1-5-1-2\" data-name=\"deposit per-unit breakdown\">(500.000₫ × 18)</span></div>\n<div class=\"text-right\" data-kid=\"1-2-2-2-2-1-5-2\" data-name=\"deposit total and status\"><div class=\"tnum font-display text-[20px]\" data-kid=\"1-2-2-2-2-1-5-2-1\" data-name=\"deposit total amount\">9.000.000₫</div><div class=\"text-[12px] text-white/45\" data-kid=\"1-2-2-2-2-1-5-2-2\" data-name=\"deposit status: not recorded\">Chưa ghi nhận</div></div>\n</div>\n</div>\n<!-- Decision footer -->\n<div class=\"flex h-[64px] shrink-0 items-center gap-2 border-t border-white/10 px-5\" data-kid=\"1-2-2-2-2-2\" data-na