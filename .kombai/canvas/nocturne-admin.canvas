      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n.font-display{font-family:'Playfair Display',Georgia,serif}\n.font-body{font-family:'Be Vietnam Pro','Helvetica Neue',sans-serif}\n.tnum{font-variant-numeric:tabular-nums}\n.hatch{background-image:repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 2px,transparent 2px 9px)}\n</style>\n<div class=\"font-body flex h-[900px] w-full flex-col overflow-hidden bg-[#141010] text-white\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- Workspace header -->\n<header class=\"flex h-[72px] shrink-0 items-center justify-between border-b border-white/10 bg-[#1D1312] px-6\" data-kid=\"1-1\" data-name=\"workspace header bar\">\n<div class=\"flex items-center gap-5\" data-kid=\"1-1-1\" data-name=\"brand identity group\">\n<span class=\"font-display text-[24px] leading-none tracking-[0.22em] text-[#F8D127]\" data-kid=\"1-1-1-1\" data-name=\"brand name logo text\">NOCTURNE</span>\n<span class=\"border border-white/20 px-2.5 py-1 text-[13px] text-white/80\" data-kid=\"1-1-1-2\" data-name=\"role badge label\">Lễ tân</span>\n</div>\n<div class=\"flex items-center gap-5\" data-kid=\"1-1-2\" data-name=\"header right controls group\">\n<button class=\"flex h-10 items-center gap-2 px-3 text-[13px] text-white/65 hover:text-white\" data-kid=\"1-1-2-1\" data-name=\"role switch button\"><i class=\"ph ph-arrows-left-right text-[16px]\" data-kid=\"1-1-2-1-1\" data-name=\"swap arrows icon\"></i>Chuyển sang Quản trị</button>\n<div class=\"flex items-center gap-3 border-l border-white/10 pl-5\" data-kid=\"1-1-2-2\" data-name=\"user profile group\">\n<div class=\"grid size-9 place-items-center rounded-full bg-[#2B2120] text-[13px] font-semibold text-[#F8D127]\" data-kid=\"1-1-2-2-1\" data-name=\"user avatar initials circle\">TT</div>\n<div class=\"leading-tight\" data-kid=\"1-1-2-2-2\" data-name=\"user name and role text group\"><div class=\"text-[14px]\" data-kid=\"1-1-2-2-2-1\" data-name=\"user name text\">Ngô Thanh Tâm</div><div class=\"text-[12px] text-white/50\" data-kid=\"1-1-2-2-2-2\" data-name=\"user role text\">Quản lý ca</div></div>\n</div>\n</div>\n</header>\n<!-- Nav strip -->\n<nav class=\"flex h-[48px] shrink-0 items-end gap-8 border-b border-white/10 bg-[#1A1312] px-6 text-[14px]\" data-kid=\"1-2\" data-name=\"main navigation strip\">\n<a class=\"flex h-full items-center gap-2 text-white/60 hover:text-white\" data-kid=\"1-2-1\" data-name=\"shift tab link\"><i class=\"ph ph-calendar-check text-[17px]\" data-kid=\"1-2-1-1\" data-name=\"calendar check icon\"></i>Ca phục vụ</a>\n<a class=\"flex h-full items-center gap-2 text-white/60 hover:text-white\" data-kid=\"1-2-2\" data-name=\"reservation tab link\"><i class=\"ph ph-list-bullets text-[17px]\" data-kid=\"1-2-2-1\" data-name=\"list bullets icon\"></i>Đặt bàn</a>\n<a class=\"flex h-full items-center gap-2 border-b-2 border-[#F8D127] text-[#F8D127]\" data-kid=\"1-2-3\" data-name=\"active space tab link\"><i class=\"ph ph-map-trifold text-[17px]\" data-kid=\"1-2-3-1\" data-name=\"map icon\"></i>Không gian</a>\n</nav>\n<!-- Service controls -->\n<div class=\"flex h-[64px] shrink-0 items-center justify-between px-6\" data-kid=\"1-3\" data-name=\"service controls bar\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-3-1\" data-name=\"left controls group\">\n<div class=\"flex items-center\" data-kid=\"1-3-1-1\" data-name=\"date navigation group\">\n<button aria-label=\"Ngày trước\" class=\"grid size-11 place-items-center border border-white/15 text-white/70\" data-kid=\"1-3-1-1-1\" data-name=\"previous day button\"><i class=\"ph ph-caret-left text-[16px]\" data-kid=\"1-3-1-1-1-1\" data-name=\"left caret icon\"></i></button>\n<button class=\"tnum flex h-11 items-center gap-2 border-y border-white/15 px-4 text-[15px]\" data-kid=\"1-3-1-1-2\" data-name=\"current date button\"><i class=\"ph ph-calendar-blank text-[17px] text-white/55\" data-kid=\"1-3-1-1-2-1\" data-name=\"calendar icon\"></i>Chủ Nhật, 08/11/2026</button>\n<button aria-label=\"Ngày sau\" class=\"grid size-11 place-items-center border border-white/15 text-white/70\" data-kid=\"1-3-1-1-3\" data-name=\"next day button\"><i class=\"ph ph-caret-right text-[16px]\" data-kid=\"1-3-1-1-3-1\" data-name=\"right caret icon\"></i></button>\n</div>\n<div class=\"tnum flex items-center gap-6 text-[14px]\" data-kid=\"1-3-1-2\" data-name=\"stat counters group\">\n<span data-kid=\"1-3-1-2-1\" data-name=\"occupied guests stat\"><span class=\"text-white/55\" data-kid=\"1-3-1-2-1-1\" data-name=\"occupied guests label\">Khách</span> <b class=\"ml-1 text-[16px] font-semibold\" data-kid=\"1-3-1-2-1-2\" data-name=\"occupied guests count\">22</b><span class=\"text-white/45\" data-kid=\"1-3-1-2-1-3\" data-name=\"occupancy denominator\">/24</span></span>\n<span data-kid=\"1-3-1-2-2\" data-name=\"table reservations stat\"><span class=\"text-white/55\" data-kid=\"1-3-1-2-2-1\" data-name=\"table reservations label\">Bàn đặt</span> <b class=\"ml-1 font-semibold\" data-kid=\"1-3-1-2-2-2\" data-name=\"table reservations count\">7</b></span>\n<span data-kid=\"1-3-1-2-3\" data-name=\"pending confirmation stat\"><span class=\"text-white/55\" data-kid=\"1-3-1-2-3-1\" data-name=\"pending confirmation label\">Chờ xác nhận</span> <b class=\"ml-1 font-semibold text-[#F8D127]\" data-kid=\"1-3-1-2-3-2\" data-name=\"pending confirmation count\">2</b></span>\n</div>\n</div>\n<div class=\"flex items-center gap-3\" data-kid=\"1-3-2\" data-name=\"right controls group\">\n<div class=\"flex border border-white/15 text-[14px]\" data-kid=\"1-3-2-1\" data-name=\"view mode toggle group\">\n<button class=\"flex h-11 items-center gap-2 bg-white/10 px-4 text-white\" data-kid=\"1-3-2-1-1\" data-name=\"active view mode button\"><i class=\"ph ph-map-trifold text-[16px]\" data-kid=\"1-3-2-1-1-1\" data-name=\"map icon\"></i>Sơ đồ</button>\n<button class=\"flex h-11 items-center gap-2 px-4 text-white/60\" data-kid=\"1-3-2-1-2\" data-name=\"inactive view mode button\"><i class=\"ph ph-list-bullets text-[16px]\" data-kid=\"1-3-2-1-2-1\" data-name=\"list bullets icon\"></i>Khách đến</button>\n</div>\n<button class=\"flex h-11 items-center gap-2 bg-[#F8D127] px-5 text-[14px] font-medium text-[#1D1312] hover:bg-white\" data-kid=\"1-3-2-2\" data-name=\"primary create reservation button\"><i class=\"ph ph-plus text-[16px]\" data-kid=\"1-3-2-2-1\" data-name=\"plus icon\"></i>Tạo đặt bàn</button>\n</div>\n</div>\n<!-- Main -->\n<div class=\"flex min-h-0 flex-1 gap-6 px-6 pb-6\" data-kid=\"1-4\" data-name=\"main content area\">\n<div class=\"flex w-[1008px] shrink-0 flex-col gap-4\" data-kid=\"1-4-1\" data-name=\"left panel column\">\n<!-- Schematic -->\n<section class=\"relative h-[520px] border border-white/10 bg-[#1A1413] p-4\" data-kid=\"1-4-1-1\" data-name=\"floor plan schematic section\">\n<div class=\"mb-3 flex items-baseline justify-between\" data-kid=\"1-4-1-1-1\" data-name=\"section header group\">\n<h2 class=\"text-[15px] font-medium text-white/85\" data-kid=\"1-4-1-1-1-1\" data-name=\"floor plan title text\">Sơ đồ không gian tầng 48</h2>\n<span class=\"text-[12px] text-white/40\" data-kid=\"1-4-1-1-1-2\" data-name=\"not-to-scale note\">Không theo tỷ lệ</span>\n</div>\n<div class=\"grid h-[452px] grid-cols-[1fr_1fr_300px] grid-rows-[118px_1fr_76px] gap-3\" data-kid=\"1-4-1-1-2\" data-name=\"floor plan grid container\">\n<!-- Bar + kitchen -->\n<div class=\"col-span-2 flex gap-3\" data-kid=\"1-4-1-1-2-1\" data-name=\"bar and kitchen row container\">\n<div class=\"hatch flex w-[120px] shrink-0 items-center justify-center border border-white/10 text-[13px] text-white/40\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"kitchen zone label\">Bếp than</div>\n<button class=\"flex flex-1 flex-col border border-white/15 bg-[#221A19] p-3 text-left hover:border-white/35\" data-kid=\"1-4-1-1-2-1-2\" data-name=\"bar counter zone button\">\n<div class=\"flex w-full items-baseline justify-between\" data-kid=\"1-4-1-1-2-1-2-1\" data-name=\"bar counter header group\"><span class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-1-2-1-1\" data-name=\"bar counter name text\">Quầy bar bếp lửa</span><span class=\"tnum text-[13px] text-white/55\" data-kid=\"1-4-1-1-2-1-2-1-2\" data-name=\"bar counter capacity text\">2 bàn, 4 khách</span></div>\n<div class=\"tnum mt-2 grid grid-cols-2 gap-x-6 gap-y-1 text-[13px] text-white/75\" data-kid=\"1-4-1-1-2-1-2-2\" data-name=\"bar counter reservations group\">\n<span data-kid=\"1-4-1-1-2-1-2-2-1\" data-name=\"bar counter reservation 1\">17:30 Lê Quang Vinh <span class=\"text-white/45\" data-kid=\"1-4-1-1-2-1-2-2-1-1\" data-name=\"bar reservation 1 party size\">2</span></span>\n<span data-kid=\"1-4-1-1-2-1-2-2-2\" data-name=\"bar counter reservation 2\">19:30 Võ Bảo Châu <span class=\"text-white/45\" data-kid=\"1-4-1-1-2-1-2-2-2-1\" data-name=\"bar reservation 2 party size\">2</span></span>\n<span class=\"text-white/35 line-through\" data-kid=\"1-4-1-1-2-1-2-2-3\" data-name=\"cancelled bar counter reservation\">21:00 Kim Ji-ho <span data-kid=\"1-4-1-1-2-1-2-2-3-1\" data-name=\"cancelled reservation party size\">2</span></span>\n</div>\n</button>\n</div>\n<!-- Window -->\n<button class=\"row-span-2 relative flex flex-col border border-[#F8D127] bg-[#F8D127]/[0.06] p-4 text-left\" data-kid=\"1-4-1-1-2-2\" data-name=\"window view zone button\">\n<span aria-hidden=\"true\" class=\"absolute inset-y-3 right-[-1px] w-[4px] border-x border-[#F8D127]/60\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"zone highlight bar\"></span>\n<span class=\"text-[15px] font-medium text-[#F8D127]\" data-kid=\"1-4-1-1-2-2-2\" data-name=\"window zone name text\">Bàn cửa sổ view thành phố</span>\n<span class=\"tnum mt-1 text-[13px] text-white/60\" data-kid=\"1-4-1-1-2-2-3\" data-name=\"window zone capacity text\">3 bàn, 6 khách</span>\n<div class=\"tnum mt-4 space-y-2 text-[13px] text-white/85\" data-kid=\"1-4-1-1-2-2-4\" data-name=\"window zone reservations group\">\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-1-2-2-4-1\" data-name=\"window reservation 1 row\"><span data-kid=\"1-4-1-1-2-2-4-1-1\" data-name=\"window reservation 1 name\">17:30 Phạm Ngọc Anh</span><span class=\"flex items-center gap-2 text-white/50\" data-kid=\"1-4-1-1-2-2-4-1-2\" data-name=\"window reservation 1 party group\">2<i class=\"ph ph-note text-[15px] text-[#F8D127]\" data-kid=\"1-4-1-1-2-2-4-1-2-1\" data-name=\"window reservation 1 note icon\"></i></span></div>\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-1-2-2-4-2\" data-name=\"window reservation 2 row\"><span data-kid=\"1-4-1-1-2-2-4-2-1\" data-name=\"window reservation 2 name\">19:00 Nguyễn Hải Yến</span><span class=\"flex items-center gap-2 text-white/50\" data-kid=\"1-4-1-1-2-2-4-2-2\" data-name=\"window reservation 2 party group\">2<i class=\"ph ph-note text-[15px] text-[#F8D127]\" data-kid=\"1-4-1-1-2-2-4-2-2-1\" data-name=\"window reservation 2 note icon\"></i></span></div>\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-1-2-2-4-3\" data-name=\"window reservation 3 row\"><span data-kid=\"1-4-1-1-2-2-4-3-1\" data-name=\"window reservation 3 name\">21:00 Hoàng Gia Linh</span><span class=\"flex items-center gap-2 text-white/50\" data-kid=\"1-4-1-1-2-2-4-3-2\" data-name=\"window reservation 3 party group\">2<i class=\"ph ph-note text-[15px] text-[#F8D127]\" data-kid=\"1-4-1-1-2-2-4-3-2-1\" data-name=\"window reservation 3 note icon\"></i></span></div>\n</div>\n<span class=\"mt-auto text-[12px] text-white/40\" data-kid=\"1-4-1-1-2-2-5\" data-name=\"window zone subtitle\">Cửa kính hướng Lê Duẩn</span>\n</button>\n<!-- Sofa -->\n<button class=\"flex flex-col border border-white/15 bg-[#221A19] p-4 text-left hover:border-white/35\" data-kid=\"1-4-1-1-2-3\" data-name=\"sofa lounge zone button\">\n<span class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-3-1\" data-name=\"sofa zone name text\">Sofa lounge</span>\n<span class=\"tnum mt-1 text-[13px] text-white/55\" data-kid=\"1-4-1-1-2-3-2\" data-name=\"sofa zone capacity text\">1 bàn, 4 khách</span>\n<div class=\"tnum mt-4 flex items-center justify-between text-[13px] text-white/85\" data-kid=\"1-4-1-1-2-3-3\" data-name=\"sofa zone reservation group\"><span data-kid=\"1-4-1-1-2-3-3-1\" data-name=\"sofa reservation name\">18:00 Đỗ Thanh Tùng</span><span class=\"flex items-center gap-2 text-white/50\" data-kid=\"1-4-1-1-2-3-3-2\" data-name=\"sofa reservation party group\">4<i class=\"ph ph-note text-[15px] text-[#F8D127]\" data-kid=\"1-4-1-1-2-3-3-2-1\" data-name=\"sofa reservation note icon\"></i></span></div>\n</button>\n<!-- Vault -->\n<button class=\"relative flex flex-col border-2 border-white/25 bg-[#241B1A] p-4 text-left hover:border-white/45\" data-kid=\"1-4-1-1-2-4\" data-name=\"vault zone button\">\n<span aria-hidden=\"true\" class=\"absolute -top-[2px] left-8 h-[2px] w-12 bg-[#1A1413]\" data-kid=\"1-4-1-1-2-4-1\" data-name=\"vault decorative bar\"></span>\n<div class=\"flex items-center justify-between\" data-kid=\"1-4-1-1-2-4-2\" data-name=\"vault header group\"><span class=\"text-[15px] font-medium\" data-kid=\"1-4-1-1-2-4-2-1\" data-name=\"vault name text\">The Obsidian Vault</span><i class=\"ph ph-door text-[17px] text-white/40\" data-kid=\"1-4-1-1-2-4-2-2\" data-name=\"door icon\"></i></div>\n<span class=\"tnum mt-1 text-[13px] text-white/55\" data-kid=\"1-4-1-1-2-4-3\" data-name=\"vault capacity text\">1 bàn, 8 khách</span>\n<div class=\"tnum mt-4 flex items-center justify-between text-[13px] text-white/85\" data-kid=\"1-4-1-1-2-4-4\" data-name=\"vault reservation group\"><span data-kid=\"1-4-1-1-2-4-4-1\" data-name=\"vault reservation name\">19:30 Trịnh Quốc Đạt</span><span class=\"flex items-center gap-2 text-white/50\" data-kid=\"1-4-1-1-2-4-4-2\" data-name=\"vault reservation party group\">8<i class=\"ph ph-note text-[15px] text-[#F8D127]\" data-kid=\"1-4-1-1-2-4-4-2-1\" data-name=\"vault reservation note icon\"></i></span></div>\n</button>\n<!-- Penthouse -->\n<button class=\"col-span-3 flex items-center justify-between border border-dashed border-white/25 px-4 text-left hover:border-white/45\" data-kid=\"1-4-1-1-2-5\" data-name=\"penthouse zone button\">\n<span class=\"text-[15px] font-medium text-white/80\" data-kid=\"1-4-1-1-2-5-1\" data-name=\"penthouse name text\">Penthouse Grand Salon <span class=\"font-normal text-white/45\" data-kid=\"1-4-1-1-2-5-1-1\">— bao trọn tầng 48</span></span>\n<span class=\"tnum text-[13px] text-white/45\" data-kid=\"1-4-1-1-2-5-2\" data-name=\"penthouse reservations count\">0 đặt bàn</span>\n</button>\n</div>\n</section>\n<!-- Arrival strip -->\n<section class=\"grid h-[116px] grid-cols-[120px_repeat(5,1fr)] border border-white/10 bg-[#1A1413]\" data-kid=\"1-4-1-2\" data-name=\"arrival strip container\">\n<button class=\"flex flex-col justify-center border-r border-white/10 bg-white/[0.06] px-4 text-left\" data-kid=\"1-4-1-2-1\" data-name=\"all-times filter button\">\n<span class=\"text-[14px] font-medium\" data-kid=\"1-4-1-2-1-1\" data-name=\"all-times label\">Tất cả giờ</span>\n<span class=\"tnum mt-1 text-[13px] text-white/55\" data-kid=\"1-4-1-2-1-2\" data-name=\"all-times capacity text\">7 bàn, 22 khách</span>\n</button>\n<button class=\"flex flex-col justify-center border-r border-white/10 px-4 text-left hover:bg-white/[0.04]\" data-kid=\"1-4-1-2-2\" data-name=\"17:30 arrival button\">\n<span class=\"tnum text-[20px] font-semibold\" data-kid=\"1-4-1-2-2-1\" data-name=\"17:30 time label\">17:30</span><span class=\"tnum text-[13px] text-white/55\" data-kid=\"1-4-1-2-2-2\" data-name=\"17:30 capacity text\">2 bàn, 4 khách</span><span class=\"mt-1 text-[12px] text-[#9CC79A]\" data-kid=\"1-4-1-2-2-3\" data-name=\"17:30 arrival status (arrived)\">2 đã đến</span>\n</button>\n<button class=\"flex flex-col justify-center border-r border-white/10 px-4 text-left hover:bg-white/[0.04]\" data-kid=\"1-4-1-2-3\" data-name=\"18:00 arrival button\">\n<span class=\"tnum text-[20px] font-semibold\" data-kid=\"1-4-1-2-3-1\" data-name=\"18:00 time label\">18:00</span><span class=\"tnum text-[13px] text-white/55\" data-kid=\"1-4-1-2-3-2\" data-name=\"18:00 capacity text\">1 bàn, 4 khách</span><span class=\"mt-1 text-[12px] text-white/40\" data-kid=\"1-4-1-2-3-3\" data-name=\"18:00 arrival status (not yet)\">0 đã đến</span>\n</button>\n<button class=\"flex flex-col justify-center border-r border-white/10 px-4 text-left hover:bg-white/[0.04]\" data-kid=\"1-4-1-2-4\" data-name=\"19:00 arrival button\">\n<span class=\"tnum text-[20px] font-semibold\" data-kid=\"1-4-1-2-4-1\" data-name=\"19:00 time label\">19:00</span><span class=\"tnum text-[13px] text-white/55\" data-kid=\"1-4-1-2-4-2\" data-name=\"19:00 capacity text\">1 bàn, 2 khách</span><span class=\"mt-1 text-[12px] text-[#F8D127]\" data-kid=\"1-4-1-2-4-3\" data-name=\"19:00 arrival status (pending)\">1 chờ xác nhận</span>\n</button>\n<button class=\"flex flex-col justify-center border-r border-white/10 px-4 text-left hover:bg-white/[0.04]\" data-kid=\"1-4-1-2-5\" data-name=\"19:30 arrival button\">\n<span class=\"tnum text-[20px] font-semibold\" data-kid=\"1-4-1-2-5-1\" data-name=\"19:30 time label\">19:30</span><span class=\"tnum text-[13px] text-white/55\" data-kid=\"1-4-1-2-5-2\" data-name=\"19:30 capacity text\">2 bàn, 10 khách</span><span class=\"mt-1 text-[12px] text-white/40\" data-kid=\"1-4-1-2-5-3\" data-name=\"19:30 arrival status (not yet)\">0 đã đến</span>\n</button>\n<button class=\"flex flex-col justify-center px-4 text-left hover:bg-white/[0.04]\" data-kid=\"1-4-1-2-6\" data-name=\"21:00 arrival button\">\n<span class=\"tnum text-[20px] font-semibold\" data-kid=\"1-4-1-2-6-1\" data-name=\"21:00 time label\">21:00</span><span class=\"tnum text-[13px] text-white/55\" data-kid=\"1-4-1-2-6-2\" data-name=\"21:00 capacity text\">1 bàn, 2 khách</span><span class=\"mt-1 text-[12px] text-[#F8D127]\" data-kid=\"1-4-1-2-6-3\" data-name=\"21:00 arrival status (pending)\">1 chờ xác nhận</span>\n</button>\n</section>\n</div>\n<!-- Space panel -->\n<aside class=\"flex min-w-0 flex-1 flex-col border border-white/10 bg-[#1F1817]\" data-kid=\"1-4-2\" data-name=\"space detail side panel\">\n<div class=\"border-b border-white/10 px-4 py-4\" data-kid=\"1-4-2-1\" data-name=\"panel header group\">\n<h3 class=\"font-display text-[22px] leading-tight\" data-kid=\"1-4-2-1-1\" data-name=\"panel zone title\">Bàn cửa sổ view thành phố</h3>\n<div class=\"tnum mt-1 flex gap-4 text-[13px] text-white/55\" data-kid=\"1-4-2-1-2\" data-name=\"panel zone meta group\"><span data-kid=\"1-4-2-1-2-1\" data-name=\"panel zone capacity text\">3 bàn, 6 khách</span><span data-kid=\"1-4-2-1-2-2\" data-name=\"panel party size range text\">Nhận nhóm 2–4 khách</span></div>\n</div>\n<ul class=\"text-[14px]\" data-kid=\"1-4-2-2\" data-name=\"reservations list\">\n<li class=\"grid h-[48px] grid-cols-[48px_1fr_24px] items-center gap-2 border-b border-white/[0.06] px-4\" data-kid=\"1-4-2-2-1\" data-name=\"collapsed reservation list item\">\n<span class=\"tnum text-white/60\" data-kid=\"1-4-2-2-1-1\" data-name=\"list item time\">17:30</span><span class=\"truncate\" data-kid=\"1-4-2-2-1-2\" data-name=\"list item guest name\">Phạm Ngọc Anh <span class=\"tnum text-white/45\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"list item party size\">2</span></span><span class=\"size-2 justify-self-end rounded-full bg-[#9CC79A]\" data-kid=\"1-4-2-2-1-3\" data-name=\"list item status indicator (paid deposit)\" title=\"Đã nhận cọc\"></span>\n</li>\n<li class=\"border-b border-white/[0.06] bg-[#F8D127]/[0.07]\" data-kid=\"1-4-2-2-2\" data-name=\"expanded reservation list item (pending)\">\n<div class=\"grid h-[48px] grid-cols-[48px_1fr_24px] items-center gap-2 px-4\" data-kid=\"1-4-2-2-2-1\" data-name=\"expanded item header row\">\n<span class=\"tnum text-w