-3 text-white/70\" data-kid=\"1-2-1-7\" data-name=\"sidebar nav item: staff\"><i class=\"ph ph-user-gear text-[18px]\" data-kid=\"1-2-1-7-1\" data-name=\"user gear icon (staff nav)\"></i>Nhân viên</a>\n</nav>\n<main class=\"flex min-w-0 flex-1 flex-col px-5 pt-4\" data-kid=\"1-2-2\" data-name=\"main content area for requests\">\n<!-- Heading/filter region -->\n<div class=\"shrink-0\" data-kid=\"1-2-2-1\" data-name=\"page heading and filter controls area\">\n<div class=\"flex h-[48px] items-center justify-between\" data-kid=\"1-2-2-1-1\" data-name=\"page title and create action header row\">\n<h1 class=\"font-display text-[28px] leading-none\" data-kid=\"1-2-2-1-1-1\" data-name=\"page title: table booking requests\">Yêu cầu đặt bàn</h1>\n<button class=\"flex h-10 items-center gap-2 bg-[#F8D127] px-5 text-[13px] font-medium text-[#1D1312] hover:bg-white\" data-kid=\"1-2-2-1-1-2\" data-name=\"primary create booking button\"><i class=\"ph ph-plus text-[16px]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"plus icon (create)\"></i>Tạo đặt bàn</button>\n</div>\n<div class=\"flex h-[60px] items-center gap-2\" data-kid=\"1-2-2-1-2\" data-name=\"filter and search toolbar row\">\n<div class=\"flex border border-white/15 text-[14px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"status filter segmented control\">\n<button class=\"flex h-10 items-center gap-2 bg-white/10 px-4\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"status filter button: awaiting confirmation (active)\">Chờ xác nhận <span class=\"tnum text-[#F8D127]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"awaiting count badge in filter\">7</span></button>\n<button class=\"h-10 px-4 text-white/60\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"status filter button: confirmed\">Đã xác nhận</button>\n<button class=\"h-10 px-4 text-white/60\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"status filter button: cancelled\">Đã hủy</button>\n<button class=\"h-10 px-4 text-white/60\" data-kid=\"1-2-2-1-2-1-4\" data-name=\"status filter button: all\">Tất cả</butt